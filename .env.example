# ---- Backend (FastAPI) ----
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://adaptaid:adaptaid@localhost:5434/adaptaid
# Generate a long random value for production: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-please-0123456789abcdef
JWT_EXPIRE_HOURS=168
COOKIE_NAME=adaptaid_session
# true behind HTTPS (production); false for plain http://localhost
COOKIE_SECURE=false
# Code a teacher must enter on the registration form
TEACHER_INVITE_CODE=TEACH-2026
# Run nightly jobs inside the API process (enable on exactly one process)
SCHEDULER_ENABLED=false
JOB_HOUR=2
OPENBLAS_NUM_THREADS=1

# ---- Frontend (Next.js) ----
# Where the Next.js server forwards /api/* (read at runtime, never exposed to the browser)
BACKEND_URL=http://localhost:8000

# ---- Docker / deployment ----
POSTGRES_USER=adaptaid
POSTGRES_PASSWORD=adaptaid
POSTGRES_DB=adaptaid
DB_PORT=5434
# Caddy site address: ":80" for a local production test, "your.domain.com" on a VPS
SITE_ADDRESS=:80
