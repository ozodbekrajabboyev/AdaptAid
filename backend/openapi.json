{
 "components": {
  "schemas": {
   "ClassCreate": {
    "properties": {
     "course_id": {
      "title": "Course Id",
      "type": "integer"
     },
     "name": {
      "maxLength": 120,
      "minLength": 2,
      "title": "Name",
      "type": "string"
     }
    },
    "required": [
     "name",
     "course_id"
    ],
    "title": "ClassCreate",
    "type": "object"
   },
   "ClassOut": {
    "properties": {
     "course_id": {
      "title": "Course Id",
      "type": "integer"
     },
     "course_title": {
      "title": "Course Title",
      "type": "string"
     },
     "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
     },
     "id": {
      "title": "Id",
      "type": "integer"
     },
     "join_code": {
      "title": "Join Code",
      "type": "string"
     },
     "n_students": {
      "title": "N Students",
      "type": "integer"
     },
     "name": {
      "title": "Name",
      "type": "string"
     },
     "teacher_id": {
      "title": "Teacher Id",
      "type": "integer"
     },
     "teacher_name": {
      "title": "Teacher Name",
      "type": "string"
     }
    },
    "required": [
     "id",
     "name",
     "course_id",
     "course_title",
     "teacher_id",
     "teacher_name",
     "join_code",
     "n_students",
     "created_at"
    ],
    "title": "ClassOut",
    "type": "object"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "title": "Detail",
      "type": "array"
     }
    },
    "title": "HTTPValidationError",
    "type": "object"
   },
   "JoinIn": {
    "properties": {
     "code": {
      "maxLength": 12,
      "minLength": 4,
      "title": "Code",
      "type": "string"
     }
    },
    "required": [
     "code"
    ],
    "title": "JoinIn",
    "type": "object"
   },
   "LoginIn": {
    "properties": {
     "email": {
      "format": "email",
      "title": "Email",
      "type": "string"
     },
     "password": {
      "title": "Password",
      "type": "string"
     }
    },
    "required": [
     "email",
     "password"
    ],
    "title": "LoginIn",
    "type": "object"
   },
   "RegisterIn": {
    "properties": {
     "email": {
      "format": "email",
      "title": "Email",
      "type": "string"
     },
     "full_name": {
      "maxLength": 120,
      "minLength": 2,
      "title": "Full Name",
      "type": "string"
     },
     "invite_code": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Invite Code"
     },
     "join_code": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Optional class code to join right away",
      "title": "Join Code"
     },
     "password": {
      "maxLength": 128,
      "minLength": 8,
      "title": "Password",
      "type": "string"
     },
     "role": {
      "default": "student",
      "enum": [
       "student",
       "teacher"
      ],
      "title": "Role",
      "type": "string"
     }
    },
    "required": [
     "email",
     "password",
     "full_name"
    ],
    "title": "RegisterIn",
    "type": "object"
   },
   "Role": {
    "enum": [
     "student",
     "teacher",
     "admin"
    ],
    "title": "Role",
    "type": "string"
   },
   "UserOut": {
    "properties": {
     "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
     },
     "email": {
      "title": "Email",
      "type": "string"
     },
     "full_name": {
      "title": "Full Name",
      "type": "string"
     },
     "id": {
      "title": "Id",
      "type": "integer"
     },
     "is_synthetic": {
      "title": "Is Synthetic",
      "type": "boolean"
     },
     "role": {
      "$ref": "#/components/schemas/Role"
     }
    },
    "required": [
     "id",
     "email",
     "full_name",
     "role",
     "is_synthetic",
     "created_at"
    ],
    "title": "UserOut",
    "type": "object"
   },
   "ValidationError": {
    "properties": {
     "ctx": {
      "title": "Context",
      "type": "object"
     },
     "input": {
      "title": "Input"
     },
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "title": "Location",
      "type": "array"
     },
     "msg": {
      "title": "Message",
      "type": "string"
     },
     "type": {
      "title": "Error Type",
      "type": "string"
     }
    },
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError",
    "type": "object"
   }
  }
 },
 "info": {
  "description": "Adaptive teaching-aid recommendation platform (NTCC minor project).",
  "title": "AdaptAid API",
  "version": "0.1.0"
 },
 "openapi": "3.1.0",
